# ApiChatbot - Configuración via .env
Portfolio__Name=Tu Nombre Aquí
Portfolio__GithubUsername=tu-usuario-github
Portfolio__SystemPrompt=Eres un asistente para el portafolio profesional de {Name}. Responde usando SOLO el contexto proporcionado. No inventes información. Si no encuentras la respuesta en el contexto, di que no tienesa información sobre eso.

# URLs de los markdowns que describen tu perfil
Portfolio__ContextUrls__About=https://raw.githubusercontent.com/tu-user/tu-repo/main/about.md
Portfolio__ContextUrls__Skills=https://raw.githubusercontent.com/tu-user/tu-repo/main/skills.md
Portfolio__ContextUrls__Projects=https://raw.githubusercontent.com/tu-user/tu-repo/main/projects.md

# --- CORS (orígenes permitidos en producción) ---
# Si tu frontend corre en otro dominio/puerto, agrégalo aquí
Cors__AllowedOrigins__0=https://tudominio.com
Cors__AllowedOrigins__1=https://www.tudominio.com

# --- Sesiones Anónimas (JWT) ---
Session__SecretKey=cambia-esta-clave-por-una-segura-de-32-caracteres-o-mas
Session__ExpiryHours=24
Session__RateLimitPerMinute=30

# --- Ollama (LLM local) ---
Ollama__BaseUrl=http://ollama:11434
Ollama__Model=qwen2.5:0.5b
Ollama__Temperature=0.7
# Modelo que se descarga automáticamente al arrancar el contenedor Ollama
OLLAMA_MODEL=qwen2.5:0.5b

# --- Analytics (Redis) ---
Analytics__RedisConnection=localhost:6379
Analytics__TtlDays=14

ASPNETCORE_ENVIRONMENT=Development