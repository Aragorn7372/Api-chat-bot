meta {
  name: Off Topic
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/chat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Session-Token: {{sessionToken}}
}

body:json {
  {
    "message": "Cuéntame sobre Pokémon Charmander"
  }
}

script:post-response {
  const data = res.getBody();
  
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Rechaza tema off-topic", function() {
    expect(data.reply).to.be.a("string").that.includes("solo puedo brindar información");
  });
}
